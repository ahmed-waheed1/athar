  "colorNotes": {
    "primary": "Brand green: primary buttons, progress ring, active nav, links",
    "onPrimary": "Text/icons on primary",
    "primaryContainer": "Tonal buttons, nav pill, soft brand chips",
    "onPrimaryContainer": "Text/icons on primaryContainer",
    "background": "Scaffold background",
    "surface": "Cards, sheets, dialogs, nav bar, rail",
    "surfaceVariant": "Segmented-control track, secondary buttons, swipe-action backdrop, no-data cells",
    "textPrimary": "Headings and body text",
    "textSecondary": "Supporting text, field labels",
    "textTertiary": "Dates, captions, inactive nav, future calendar days",
    "divider": "Dividers, card/frame borders, empty progress dots",
    "fieldBorder": "Resting text-field border, switch off track border",
    "success": "Positive state (same value as the Leaf habit accent)",
    "onSuccess": "Icons on success",
    "error": "Delete, reset, validation errors",
    "onError": "Text on error buttons",
    "errorContainer": "Soft error chips (delete/reset icon tiles)",
    "flame": "Streak flame icon + streak label",
    "flameSoft": "Soft background behind the flame (toast, badges). Dark = flame at 18% alpha (AARRGGBB)",
    "ringTrack": "Progress-ring track",
    "inverseSurface": "Toast / snackbar background",
    "onInverseSurface": "Toast / snackbar text",
    "scrim": "Modal scrim (AARRGGBB): light 50% #0A1411, dark 66% black"
  },
  "heatmap": {
