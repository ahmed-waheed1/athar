  "shadow": {
    "card": {
      "light": [
        {
          "x": 0,
          "y": 1,
          "blur": 2,
          "spread": 0,
          "color": "#0D13201C"
        },
        {
          "x": 0,
          "y": 6,
          "blur": 18,
          "spread": 0,
          "color": "#0F13201C"
        }
      ],
      "dark": [
        {
          "x": 0,
          "y": 1,
          "blur": 2,
          "spread": 0,
          "color": "#4D000000"
        },
        {
          "x": 0,
          "y": 6,
          "blur": 18,
          "spread": 0,
          "color": "#33000000"
        }
      ]
    },
    "raised": {
      "light": [
        {
          "x": 0,
          "y": 24,
          "blur": 60,
          "spread": 0,
          "color": "#2E000000"
        }
      ],
      "dark": [
        {
          "x": 0,
          "y": 24,
          "blur": 60,
          "spread": 0,
          "color": "#4D000000"
        }
      ]
    },
    "toast": {
      "light": [
        {
          "x": 0,
          "y": 12,
          "blur": 28,
          "spread": -6,
          "color": "#40000000"
        }
      ],
      "dark": [
        {
          "x": 0,
          "y": 12,
          "blur": 28,
          "spread": -6,
          "color": "#66000000"
        }
      ]
    }
  },
  "motion": {
    "checkPop": {
      "durationMs": 500,
      "curve": "easeOutBack",
      "use": "Check button scales 0.82 -> 1.0 when a habit is checked; HapticFeedback.lightImpact()"
    },
    "ringProgress": {
      "durationMs": 1400,
      "curve": "easeOutCubic",
      "use": "Progress ring sweeps from its old to its new value"
    },
    "swipeReveal": {
      "durationMs": 350,
      "curve": "fastOutSlowIn",
      "use": "Habit card slides 144px toward the start edge to reveal Edit/Delete"
    },
    "toastIn": {
      "durationMs": 250,
      "curve": "easeOutCubic",
      "use": "Toast slides up 16px + fades in; stays 3000ms"
    },
    "toastOut": {
      "durationMs": 200,
      "curve": "easeInCubic",
      "use": "Toast fades out"
    },
    "dialogIn": {
      "durationMs": 350,
      "curve": "easeOutBack",
      "use": "Dialogs/milestone card fade in and scale 0.92 -> 1.0"
    },
    "sheetIn": {
      "durationMs": 300,
      "curve": "easeOutCubic",
      "use": "Bottom sheets slide up"
    },
    "pageTransition": {
      "durationMs": 300,
      "curve": "easeInOutCubic",
      "use": "Push/pop: horizontal slide that follows text direction (Cupertino-style); fade-through between nav tabs"
    },
    "milestoneDotStagger": {
      "durationMs": 90,
      "curve": "easeOutBack",
      "use": "Delay between each dot filling in the milestone ring (each dot pops in 500ms)"
    },
    "confetti": {
      "durationMs": 3200,
      "curve": "linear",
      "use": "Confetti fall duration per piece (2.6-4.2s randomised), 36 pieces, loops while the modal is open"
    },
    "onboardingPage": {
      "durationMs": 350,
      "curve": "easeOutCubic",
      "use": "PageView slide between onboarding slides; indicator pill widens 8 -> 24px"
    }
  },
  "numerals": {
    "en": "0123456789 (Western)",
    "ar": "٠١٢٣٤٥٦٧٨٩ (Arabic-Indic, locale ar-EG) for all numbers, percentages and dates"
  }
